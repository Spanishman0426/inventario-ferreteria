# Nombre: .gitignore
# Descripción: Archivos y carpetas que Git no debe versionar (compilados, dependencias,
#              configuraciones locales de IDE, variables de entorno y certificados).
# Fecha de creación: 2026-10-20
# Última actualización: 2026-10-21
# Autor: Juan Pablo Artunduaga Pérez (generado con Claude Code)

# --- Java / Maven ---
target/
build/
*.class
*.log
hs_err_pid*
replay_pid*
.mvn/wrapper/maven-wrapper.jar

# --- Node / Vite ---
node_modules/
dist/
coverage/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Playwright ---
test-results/
playwright-report/
blob-report/
playwright/.cache/

# --- Reportes E2E (Playwright y Selenium) ---
e2e/playwright/reportes/
e2e/selenium/reportes/

# --- k6 (la carpeta se conserva con .gitkeep porque k6 no crea carpetas al guardar el resumen) ---
load-tests/results/*
!load-tests/results/.gitkeep

# --- Reportes generados (JUnit del frontend y criterios de aceptación) ---
frontend/reportes/
reportes/

# --- Python (database/oraculo.py) ---
__pycache__/
*.pyc
.venv/

# --- IDEs ---
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
.settings/
.project
.classpath
.factorypath
*.swp

# --- Sistema operativo ---
.DS_Store
Thumbs.db
desktop.ini

# --- Variables de entorno (solo se versiona .env.example) ---
.env
.env.*
!.env.example

# --- Certificados y llaves ---
*.p12
*.jks
*.pem
*.key
*.pfx
*.crt

# --- Claude Code (configuración local) ---
.claude/settings.local.json

# --- Backend: keystore HTTPS de desarrollo ---
backend/certs/

# --- CI: resúmenes, imágenes y logs generados en local por .github/scripts y los pasos del pipeline ---
resumen-*.json
imagenes-e2e.tar.gz
logs-entorno-*.txt
