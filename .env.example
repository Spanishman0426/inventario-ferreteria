# Nombre: .env.example
# Descripción: Variables del entorno de pruebas end-to-end (docker-compose.e2e.yml, e2e/playwright y
#              e2e/selenium) con valores FICTICIOS. Copiar a .env en la raíz (ignorado por Git) y
#              cambiarlos. En CI se generan valores aleatorios en cada ejecución.
# Fecha de creación: 2026-10-21
# Última actualización: 2026-10-21
# Autor: Juan Pablo Artunduaga Pérez (generado con Claude Code)

# --- Puerto local del frontend compilado (nginx); las pruebas usan http://localhost:<puerto> ---
E2E_PUERTO=8088

# --- PostgreSQL descartable del entorno e2e ---
E2E_DB_PASSWORD=cambiar-clave-bd-e2e

# --- Clave para firmar los JWT del backend e2e (32 caracteres o más) ---
E2E_JWT_SECRET=cambiar-por-una-clave-aleatoria-de-al-menos-32-caracteres

# --- Contraseñas de los usuarios de prueba (perfil e2e del backend y pruebas) ---
E2E_ADMIN_PASSWORD=Cambiar-Admin-123
E2E_JEFE_PASSWORD=Cambiar-Jefe-123
E2E_VENDEDOR_PASSWORD=Cambiar-Vendedor-123

# --- Opcional: URL base que usan las pruebas (por defecto http://127.0.0.1:${E2E_PUERTO}) ---
# E2E_BASE_URL=http://127.0.0.1:8088
