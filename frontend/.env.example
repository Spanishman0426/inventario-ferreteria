# URL base de la API. Vacía en desarrollo: el navegador llama a /api y el proxy de Vite la reenvía.
# En producción, la URL pública del backend, por ejemplo https://api.ferreteria.example
VITE_API_URL=

# Destino del proxy de Vite en desarrollo (backend con perfil dev y certificado autofirmado).
VITE_PROXY_TARGET=https://localhost:8443
