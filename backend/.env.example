# Nombre: .env.example
# Descripción: Variables de entorno del perfil dev con valores FICTICIOS. Copiar a backend/.env (ignorado por Git) y cambiar los valores.
# Fecha de creación: 2026-10-20
# Última actualización: 2026-10-20
# Autor: Juan Pablo Artunduaga Pérez (generado con Claude Code)

# --- Base de datos local ---
DB_URL=jdbc:postgresql://localhost:5432/ferreteria_dev
DB_USER=postgres
DB_PASSWORD=cambiar-esta-clave

# --- Keystore HTTPS de desarrollo (lo usa scripts/generar-certificado-dev y el perfil dev) ---
SSL_KEYSTORE_PASSWORD=cambiar-esta-clave-del-keystore

# --- Seguridad (RF-SEG-001) ---
# Clave para firmar los JWT: al menos 32 caracteres aleatorios (por ejemplo, openssl rand -base64 48)
JWT_SECRET=cambiar-por-una-clave-aleatoria-de-al-menos-32-caracteres
# Único origen admitido por CORS
FRONTEND_URL=http://localhost:5173

# --- Primer administrador (solo perfil dev; se crea si no existe ninguno) ---
ADMIN_USUARIO=admin
ADMIN_PASSWORD=admin123
ADMIN_CORREO=admin@ferreteria.local
ADMIN_NOMBRE=Administrador

# --- Perfil prod (lo define la plataforma de despliegue) ---
# PORT=8080
# JWT_SECRET y FRONTEND_URL también son obligatorias en prod
# OPENAPI_HABILITADO=true
